{
  "compileOnSave": true,
  "compilerOptions": {
    "outDir": "./dist",
    "module": "node16",
    "types": ["node", "multer"],
    "target": "es2021",
    "rootDir": ".",
    "declaration": false,
    "strictPropertyInitialization": false,
    "strict": false,
    "moduleResolution": "node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@shared-libs": ["./libs/index"],
      "*": ["./*"]
    },
  }
}
