{
  "compileOnSave": true,
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "types": ["node", "multer"],
    "target": "es2021",
    "rootDir": ".",
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@shared-libs": ["libs/index"]
    },
  }
}
