# Listen (put nginx/caddy in front for wss://)
PORT=8090
HOST=0.0.0.0

# Upstox (server-side only)
UPSTOX_ACCESS_TOKEN=
# Optional overrides; by default the relay selects unexpired standard MCX futures.
# UPSTOX_GOLD_INSTRUMENT_KEY=MCX_FO|...
# UPSTOX_SILVER_INSTRUMENT_KEY=MCX_FO|...
UPSTOX_GOLD_LTP_GRAMS=10
# true when silver contract LTP is quoted per kilogram; false when already per gram
UPSTOX_SILVER_LTP_PER_KG=true

# Same JWT settings as ByajBazaar Backend (users access token)
TOKEN_SECRET=
TOKEN_AUDIENCE=usersAudience
TOKEN_ISSUER=UsersIssuer
TOKEN_ALG=HS256
