[Unit]
Description=ByajBazaar Upstox MCX live market relay
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/byajbazaar/upstox-instance
EnvironmentFile=/opt/byajbazaar/upstox-instance/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
