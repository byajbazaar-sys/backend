{
  "name": "byajbazaar-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "sls": "serverless",
    "sls:deploy": "serverless deploy",
    "sls:deploy:dev": "yarn build && serverless deploy --stage dev && serverless invoke -f runPostDeploy --stage dev",
    "sls:deploy:staging": "yarn build && serverless deploy --stage staging && serverless invoke -f runPostDeploy --stage staging",
    "sls:deploy:production": "yarn build && serverless deploy --stage production && serverless invoke -f runPostDeploy --stage production",
    "sls:setup-ssm": "bash scripts/setup-ssm-rds.sh",
    "sls:deploy:function": "serverless deploy function",
    "sls:remove": "serverless remove",
    "sls:offline": "npm run build && serverless offline",
    "sls:package": "serverless package",
    "typeorm": "ts-node -r tsconfig-paths/register -P ./tsconfig.json ./node_modules/typeorm/cli.js",
    "migration:show": "npm run typeorm migration:show -- -d ./src/infrastructure/persistence/type-orm.config.ts",
    "migration:up": "npm run typeorm migration:run -- -d ./src/infrastructure/persistence/type-orm.config.ts",
    "migration:generate": "npm run typeorm -- -d ./src/infrastructure/persistence/type-orm.config.ts migration:generate ./src/infrastructure/persistence/migrations/migration",
    "migration:create": "npm run typeorm -- migration:create ./src/infrastructure/persistence/migrations/migration",
    "migration:down": "npm run typeorm -- -d ./src/infrastructure/persistence/type-orm.config.ts migration:revert",
    "schema:drop": "npm run typeorm -- -d ./src/infrastructure/persistence/type-orm.config.ts schema:drop"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
