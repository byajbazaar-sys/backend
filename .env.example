# Copy to .env (local) or .env.dev / .env.production — never commit real values.

NODE_ENV=development
API_PORT=3000
GLOBAL_PREFIX=api

# Live MCX gold/silver: upstox-instance relay only (see upstox-instance/README.md). No Upstox vars on Lambda.

# Redis (Upstash: rediss://default:token@host:6379)
REDIS_URL=
REDIS_MAX_RECONNECTION_ATTEMPTS=10
REDIS_RECONNECTION_DELAY_MS=5000

# Database (PostgreSQL — Neon or local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=

# Auth JWT
TOKEN_SECRET=
TOKEN_AUDIENCE=usersAudience
TOKEN_ISSUER=UsersIssuer

# AWS (S3 / Lambda)
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_BUCKET_REGION=ap-south-1
# Optional S3-compatible endpoint (e.g. Backblaze B2: https://s3.us-west-004.backblazeb2.com)
S3_ENDPOINT=

# Public image CDN (Cloudflare Worker). When set, inventory + shop-logo keys use stable CDN URLs.
# Example: https://images.byajbazaar.com
IMAGE_CDN_URL=https://images.byajbazaar.com


LAMBDA_AWS_REGION=ap-south-1
LAMBDA_AWS_ACCESS_KEY_ID=
LAMBDA_AWS_SECRET_ACCESS_KEY=

# Virtual try-on
TRY_ON_LAMBDA_NAME=
TRY_ON_INLINE=true

# Aivot third-party virtual try-on (set TRY_ON_PROVIDER=aivot)
TRYON_API_BASE_URL=https://tryon.aivot.ai/api/v1
TRYON_API_TIMEOUT_MS=90000
TRYON_API_MAX_RETRIES=2

# Cloudflare Workers AI virtual try-on (set TRY_ON_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
# Comma-separated account IDs + tokens (paired by index for multi-account rotation)
CLOUDFLARE_API_TOKEN=
# Models: flux-2-klein-9b (default, balanced), flux-2-klein-4b (cheapest), flux-2-dev (best, expensive)
CLOUDFLARE_TRYON_MODEL=@cf/black-forest-labs/flux-2-klein-9b
CLOUDFLARE_TRYON_TIMEOUT_MS=120000
CLOUDFLARE_TRYON_MAX_RETRIES=2

# Email (Resend)
RESEND_API_KEY=
RESEND_SENDER=no-reply@byajbazaar.com
RESEND_SENDER_NAME=Byajbazaar

# Web / OAuth
WEB_APP_DOMAIN=http://localhost:3000
CATALOG_BASE_DOMAIN=byajbazaar.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MOBILE_CLIENT_ID=
# Comma-separated Google OAuth client IDs for native mobile sign-in (Android/iOS).
# Example: 123-android.apps.googleusercontent.com,123-ios.apps.googleusercontent.com

# Play Integrity / App Attest — mobile Google SSO only. Web still uses authCode.
# Leave unset until Play Integrity API + service account are ready; mobile Google will then fail closed.
APP_INTEGRITY_ALLOW_DEV=false
GOOGLE_CLOUD_PROJECT_NUMBER=
ANDROID_PACKAGE_NAME=com.byajbazaar.app
APPLE_BUNDLE_ID=com.byajbazaar.app
APPLE_TEAM_ID=
# Local/dev: single-line JSON for a Play Integrity service account.
# Lambda: stored in SSM (not injected into env — avoids 4 KB Lambda env limit).
#   aws ssm put-parameter --name "/byajbazaar/dev/google-play-service-account-json" \
#     --type SecureString --value file://path/to/service-account.json --overwrite
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# GOOGLE_PLAY_SERVICE_ACCOUNT_SSM_PATH=/byajbazaar/dev/google-play-service-account-json

# Razorpay Subscriptions (never expose KEY_SECRET / WEBHOOK_SECRET to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# StartMessaging OTP SMS (https://startmessaging.com). Delivery only: codes are generated and
# checked by the backend and never stored. Indian mobiles (+91) only.
START_MESSAGING_API_KEY=
# Optional: OTP template id from the StartMessaging dashboard (default template otherwise).
START_MESSAGING_TEMPLATE_ID=
# Optional: secret for signing one-time-code challenges (defaults to a key derived from TOKEN_SECRET).
OTP_SECRET=
# Trial length is fixed at 7 days in code (TRIAL_DAYS in libs/constants); this variable is no longer read.

# Meta WhatsApp Cloud API (never expose secrets/tokens to the frontend)
META_GRAPH_API_VERSION=v22.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Face search (FaceMatch VM + Qdrant — keep secrets server-side only)
# FaceMatch API: POST /embed?purpose=index|compare (see ~/facematch/python-insight-face)
FACE_COMPARE_API_URL=http://140.245.93.109:8000
# Legacy alias:
# INSIGHTFACE_API_URL=http://140.245.93.109:8000
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=customer_faces
QDRANT_VECTOR_SIZE=512
FACE_MATCH_THRESHOLD=0.45
FACE_COMPARE_TIMEOUT_MS=30000

# WebSocket (local offline)
WEBSOCKET_API_URL=ws://127.0.0.1:3001
WEBSOCKET_API_ENDPOINT=

# --- Marketing videos (experimental) ---
# Kaggle accounts (GPU T4 x2) are stored in the marketing DB table kaggle_credentials and managed by admins via
# /marketing/admin/kaggle-credentials. Their API keys are encrypted with this secret (defaults to TOKEN_SECRET).
# Changing it makes stored keys unreadable — they must then be re-entered.
MARKETING_CREDENTIALS_SECRET=
# Signs per-job tokens the Kaggle notebook uses on the WebSocket (defaults to one derived from TOKEN_SECRET).
MARKETING_WORKER_SECRET=
# Public API base (https://api.example.com) for the notebook's HTTPS fallback when the WebSocket is down. Optional.
MARKETING_API_BASE_URL=
# Notebooks connect to WEBSOCKET_API_URL (wss://…) to stream progress.
# Marketing's own resources (each falls back to the main DB_* / S3_* value when empty):
MARKETING_DB_HOST=
MARKETING_DB_PORT=5432
MARKETING_DB_NAME=
MARKETING_DB_USER=
MARKETING_DB_PASS=
MARKETING_S3_AWS_ACCESS_KEY_ID=
MARKETING_S3_AWS_SECRET_ACCESS_KEY=
MARKETING_S3_BUCKET_NAME=
MARKETING_S3_BUCKET_REGION=ap-south-1
MARKETING_S3_ENDPOINT=
# Upstash QStash job queue (needs MARKETING_API_BASE_URL so QStash can call back).
MARKETING_QSTASH_URL=https://qstash.upstash.io
MARKETING_QSTASH_TOKEN=
MARKETING_QSTASH_CURRENT_SIGNING_KEY=
MARKETING_QSTASH_NEXT_SIGNING_KEY=

# --- Logs database (bill history, transaction edit history, WhatsApp message log, dues / payments / marketing activity) ---
# Separate PostgreSQL database for logs (src/logs). Leave LOGS_DB_HOST empty to keep logs in the main database.
# On Lambda these go to the SSM parameter /byajbazaar/<stage>/logs-config (serverless/logs-config.js), not the env.
# Existing rows are copied with `yarn logs:migrate-data` (see scripts/migrate-logs-to-logs-db.ts); each log stream
# switches to this database only once all its rows are copied.
LOGS_DB_HOST=
LOGS_DB_PORT=5432
LOGS_DB_NAME=
LOGS_DB_USER=
LOGS_DB_PASS=
# Optional: give up connecting to the logs DB after this many ms (logs then wait in the main-DB outbox). Default 5000.
LOGS_DB_CONNECT_TIMEOUT_MS=
