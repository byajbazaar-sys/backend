# Copy to .env (local) or .env.dev / .env.prod — never commit real values.

NODE_ENV=development
API_PORT=3000
GLOBAL_PREFIX=api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=

# Auth JWT
TOKEN_SECRET=
TOKEN_AUDIENCE=usersAudience
TOKEN_ISSUER=UsersIssuer

# AWS (S3 / Lambda / SES)
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
S3_BUCKET_REGION=ap-south-1
LAMBDA_AWS_REGION=ap-south-1
LAMBDA_AWS_ACCESS_KEY_ID=
LAMBDA_AWS_SECRET_ACCESS_KEY=

# AI
AI_PROVIDER=bedrock
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
# Comma-separated Gemini keys (used when AI_PROVIDER=gemini)
GEMINI_API_KEYS=
# AWS Bedrock (used when AI_PROVIDER=bedrock; defaults to AWS_REGION if unset)
BEDROCK_AWS_REGION=
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
# Use inference profile ID (not raw foundation model ID)
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
EVENTS_SYNC_SECRET=
TRY_ON_LAMBDA_NAME=
TRY_ON_INLINE=true
AI_CLAUDE_API_KEY=

# Aivot third-party virtual try-on (no API key — public multipart endpoint)
TRY_ON_PROVIDER=aivot
TRYON_API_BASE_URL=https://tryon.aivot.ai/api/v1
TRYON_API_TIMEOUT_MS=90000
TRYON_API_MAX_RETRIES=2

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEST_TO_NUMBER=

# Email (set EMAIL_SERVICE_PROVIDER to sendgrid | ses | resend)
EMAIL_SERVICE_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_SENDER=
SENDGRID_SENDER_NAME=
SES_AWS_REGION=ap-south-1
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_SENDER=
SES_SENDER_NAME=
RESEND_API_KEY=re_ZyZXCZ86_A2JuGZcZth5rp2vMZVeR6qvF
RESEND_SENDER=no-reply@byajbazaar.com
RESEND_SENDER_NAME=Byajbazaar

# Web / OAuth
WEB_APP_DOMAIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Subscriptions (never expose KEY_SECRET / WEBHOOK_SECRET to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_TRIAL_DAYS=7

# WebSocket (local offline)
WEBSOCKET_API_URL=ws://127.0.0.1:3001
WEBSOCKET_API_ENDPOINT=
