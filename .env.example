# Copy to .env (local) or .env.dev / .env.production — never commit real values.

NODE_ENV=development
API_PORT=3000
GLOBAL_PREFIX=api

# Redis (Upstash: rediss://default:token@host:6379)
REDIS_URL=
REDIS_CONNECTION_NAME=byajbazaar-backend
REDIS_MAX_RECONNECTION_ATTEMPTS=10
REDIS_RECONNECTION_DELAY_MS=5000

# Database (PostgreSQL — Neon or local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=

# Auth JWT
TOKEN_SECRET=
TOKEN_AUDIENCE=usersAudience
TOKEN_ISSUER=UsersIssuer

# AWS (S3 / Lambda / SES)
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_BUCKET_REGION=ap-south-1
# Optional S3-compatible endpoint (e.g. Backblaze B2: https://s3.us-west-004.backblazeb2.com)
S3_ENDPOINT=
# Key prefix inside the bucket. Use "dev" for a shared AWS bucket; use "-" or leave empty with
# S3_ENDPOINT set for dedicated B2 buckets where objects live at bucket root (inventory/...).
S3_KEY_PREFIX=
LAMBDA_AWS_REGION=ap-south-1
LAMBDA_AWS_ACCESS_KEY_ID=
LAMBDA_AWS_SECRET_ACCESS_KEY=

# AI
AI_PROVIDER=bedrock
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
# Comma-separated Gemini keys (used when AI_PROVIDER=gemini)
GEMINI_API_KEYS=
# AWS Bedrock (used when AI_PROVIDER=bedrock; defaults to AWS_REGION if unset)
BEDROCK_AWS_REGION=
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
# Use inference profile ID (not raw foundation model ID)
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
EVENTS_SYNC_SECRET=
TRY_ON_LAMBDA_NAME=
TRY_ON_INLINE=true
AI_CLAUDE_API_KEY=

# Aivot third-party virtual try-on (no API key — public multipart endpoint)
TRY_ON_PROVIDER=aivot
TRYON_API_BASE_URL=https://tryon.aivot.ai/api/v1
TRYON_API_TIMEOUT_MS=90000
TRYON_API_MAX_RETRIES=2

# Replicate FLUX.2 virtual try-on (set TRY_ON_PROVIDER=replicate)
REPLICATE_API_TOKEN=
REPLICATE_TRYON_MODEL=black-forest-labs/flux-2-pro
REPLICATE_TRYON_TIMEOUT_MS=120000
REPLICATE_TRYON_MAX_RETRIES=2

# Cloudflare Workers AI virtual try-on (set TRY_ON_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
# Comma-separated account IDs + tokens (paired by index for multi-account rotation)
CLOUDFLARE_API_TOKEN=
# Models: flux-2-klein-9b (default, balanced), flux-2-klein-4b (cheapest), flux-2-dev (best, expensive)
CLOUDFLARE_TRYON_MODEL=@cf/black-forest-labs/flux-2-klein-9b
CLOUDFLARE_TRYON_TIMEOUT_MS=180000
CLOUDFLARE_TRYON_MAX_RETRIES=2
CLOUDFLARE_TRYON_GUIDANCE=7.5

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEST_TO_NUMBER=

# Email (set EMAIL_SERVICE_PROVIDER to sendgrid | ses | resend)
EMAIL_SERVICE_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_SENDER=
SENDGRID_SENDER_NAME=
SES_AWS_REGION=ap-south-1
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_SENDER=
SES_SENDER_NAME=
RESEND_API_KEY=
RESEND_SENDER=no-reply@byajbazaar.com
RESEND_SENDER_NAME=Byajbazaar

# Web / OAuth
WEB_APP_DOMAIN=http://localhost:3000
CATALOG_BASE_DOMAIN=byajbazaar.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Subscriptions (never expose KEY_SECRET / WEBHOOK_SECRET to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_TRIAL_DAYS=7

# WebSocket (local offline)
WEBSOCKET_API_URL=ws://127.0.0.1:3001
WEBSOCKET_API_ENDPOINT=
