{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "target": "es2021",
    "moduleResolution": "node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
  },
  "include": [
    "src/**/*",
    "libs/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
} 